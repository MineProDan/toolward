#!/bin/sh
# Git pre-commit hook: block the commit if the privacy scan finds anything.
# Install (see CONTRIBUTING.md): ln -s ../../scripts/pre-commit .git/hooks/pre-commit
# Note: it scans the working tree, so it also catches files you have not staged yet.

if ! uv run python scripts/scan_for_secrets.py; then
    echo "Commit blocked by the privacy scan. Remove the flagged values and try again."
    exit 1
fi
